# Postgres. Nothing in this app talks to a service you have not configured.
# On Railway both of these are ${{Postgres.DATABASE_URL}}. See DEPLOY.md.
DATABASE_URL="postgresql://user@localhost:5432/adaptive_lp_dev"
# Migrations need a direct session. Same value on Railway; differs on Supabase/Neon.
DIRECT_URL="postgresql://user@localhost:5432/adaptive_lp_dev"

# Required for the chat interface and every generation feature.
ANTHROPIC_API_KEY=""

# Where the app is reachable. Used in the tracker snippet and CNAME hints.
APP_URL="http://localhost:4400"

# Optional. If set, lead notifications are emailed through Resend.
RESEND_API_KEY=""
RESEND_FROM=""

# Wildcard root you own and have pointed *.<root> at this app. Any subdomain of
# it works instantly with no per-page DNS.
WILDCARD_ROOT=""
# Extra hostnames the app itself answers on (comma separated).
APP_HOSTS=""
# Only needed if a customer points an apex domain at you with an A record.
APP_IP=""

# Registering customer hostnames with the host, automatically.
#
# DNS is only half of a custom domain: whatever terminates HTTPS also has to
# know the hostname, or it answers 404 and never issues a certificate. With
# these set, attaching a domain in the app registers it with Vercel in the same
# request, which is the difference between one customer and a thousand. Leave
# blank when a wildcard covers everything, or when self-hosting behind a proxy
# that already answers on every hostname.
#
# Token: Vercel account settings -> Tokens, scoped to the project's team.
# Project id: Vercel project settings -> General.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
# Only for a project owned by a team rather than a personal account.
VERCEL_TEAM_ID=""

# Media uploads. Both are needed before images or video can be uploaded; the
# app runs fine without them, pages just cannot carry media. The secret key is
# Supabase's service key from Project Settings -> API keys. It is server-only
# and must never be exposed to the browser. The bucket is created on first use.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# Clerk. Leave blank to run as a single local account with no sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Shared secret for POST /api/webhooks/plan {email, plan}. Blank disables it.
PLAN_WEBHOOK_SECRET=""

# Comma-separated. These accounts can see /admin and change anyone's plan.
ADMIN_EMAILS=""

# The published page served at "/" to signed-out visitors. Leave blank when the
# marketing site has its own hostname: "/" then redirects to sign-in, and this
# domain is purely the app.
MARKETING_SLUG=""

# Shown as a "Source" button on the marketing page. Blank hides it.
GITHUB_URL=""
# Footer credit on the marketing page.
PROJECT_BY=""
PROJECT_BY_URL=""

# Turns funded by the operator's key before an account must supply its own.
FREE_MESSAGES="10"

# Optional. Lets an uptime monitor read the full /api/health report without a
# session, as ?token=<value> or an Authorization: Bearer header. Signed-in users
# always see it. Unset means the detail is visible only after signing in.
HEALTH_TOKEN=""

# Salt for hashing submitter addresses in the spam counter. Any private string.
IP_HASH_SALT=""
